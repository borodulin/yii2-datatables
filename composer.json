{
    "name": "conquer/datatables",
    "description": "Yii2 datatables widget",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "datatables"
    ],
    "homepage": "https://github.com/borodulin/yii2-datatables",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.1.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0.6",
        "bower-asset/datatables.net": "^1.10.16",
        "bower-asset/datatables.net-plugins": "^1.10.16",
        "bower-asset/datatables.net-bs": "^1.10.16",
        "bower-asset/datatables.net-fixedheader": "^3.1.3",
        "bower-asset/datatables.net-fixedheader-bs": "^3.1.3",
        "bower-asset/datatables.net-scroller": "^1.4.3",
        "bower-asset/datatables.net-scroller-bs": "^1.4.3",
        "bower-asset/datatables.net-rowgroup": "^1.0.2",
        "bower-asset/datatables.net-rowgroup-bs": "^1.0.2",
        "bower-asset/datatables.net-rowreorder": "^1.2.3",
        "bower-asset/datatables.net-rowreorder-bs": "^1.2.3",
        "bower-asset/datatables.net-select": "^1.2.3",
        "bower-asset/datatables.net-select-bs": "^1.2.3",
        "bower-asset/datatables.net-colreorder": "^1.4.1",
        "bower-asset/datatables.net-colreorder-bs": "^1.4.1",
        "bower-asset/datatables.net-keytable": "^2.3.2",
        "bower-asset/datatables.net-keytable-bs": "^2.3.2",
        "bower-asset/datatables.net-fixedcolumns": "^3.2.3",
        "bower-asset/datatables.net-fixedcolumns-bs": "^3.2.3",
        "bower-asset/datatables.net-responsive": "^2.2.0",
        "bower-asset/datatables.net-responsive-bs": "^2.2.0",
        "bower-asset/datatables.net-autofill": "^2.2.2",
        "bower-asset/datatables.net-autofill-bs": "^2.2.2",
        "bower-asset/datatables.net-buttons": "^1.1.2",
        "bower-asset/datatables.net-buttons-bs": "^1.1.2"
    },
    "suggest": {
        "bower-asset/datatables.net-bs4": "Bootstrap 4 styling (and the -bs4 packages of the extensions you use)",
        "npm-asset/datatables.net-bs5": "Bootstrap 5 styling (and the -bs5 packages of the extensions you use)"
    },
    "autoload": {
        "psr-4": {
            "conquer\\datatables\\": ""
        }
    }
}
